{
  "title": "LLM / Llama",
  "uid": "llama-swap",
  "tags": [
    "llama-swap",
    "llm",
    "inference",
    "gpu"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "30s",
  "autoRefresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(llamaswap_gpu_util_percent, job)",
        "refresh": 2,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(llamaswap_gpu_util_percent{job=\"$job\"}, namespace)",
        "refresh": 2,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "gpu",
        "label": "GPU",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(llamaswap_gpu_util_percent{job=\"$job\", namespace=\"$namespace\"}, id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(llamaswap_model_info{job=\"$job\", namespace=\"$namespace\"}, model)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "day_of_month",
        "label": "Day of Month",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "query_result(scalar(day_of_month(vector(time()))))",
        "refresh": 2,
        "hide": 2,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "KPI",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 8,
      "title": "Energy (24h)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(sum_over_time(llamaswap_gpu_power_draw_watts{job=\"$job\", namespace=\"$namespace\", id=~\"$gpu\"}[24h])) * 30 / 3600 / 1000",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwh",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
